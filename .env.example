# Copia questo file in .env.local e completa i valori.

# In sviluppo le chiamate passano dal proxy di Vite (vedi vite.config.ts),
# che inoltra /api e /auth a http://localhost:8080: lasciare questi valori relativi.
VITE_REACT_APP_API_URL=/api
# Vuoto: il login va a /auth/login sullo stesso host del frontend.
VITE_REACT_APP_URL=

# Chiave segreta per cifrare lo store redux-persist (stringa casuale).
VITE_REACT_APP_PERSIST_KEY=
